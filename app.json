{
  "expo": {
    "name": "Hlala Link",
    "slug": "hlala-link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-android.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app-icon-android.png",
      "resizeMode": "contain",
      "backgroundColor": "#30338F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hlalalink.app"
    },
    "android": {
      "package": "com.hlalalink.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-android.png",
        "backgroundColor": "#30338F"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#0A84FF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "0c017b89-8f01-4f27-9711-4bd62aa0e367"
      }
    },
    "owner": "ehsanum"
  }
}
