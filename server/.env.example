# ============================================================
# Hlala Link API — cPanel deployment settings
# Copy these into your cPanel Node.js app's environment
# (Setup Node.js App > Environment Variables) or a server/.env
# file on the server. NEVER commit the real values to git.
# ============================================================

# --- Database: Supabase Postgres (recommended) ---
# Supabase Dashboard > Project Settings > Database > Connection string
# Use the pooled (port 6543) connection for shared hosting.
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# --- ...or plain Postgres without DATABASE_URL ---
# DB_HOST=db.[project-ref].supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=[db-password]
# DB_SSL=true

# --- Auth (generate a fresh one per environment) ---
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=replace-with-at-least-32-random-bytes

# --- CORS: your public frontend origin(s), comma-separated ---
CORS_ORIGINS=https://yourdomain.com

# --- Uploads: keep outside the public web root ---
# UPLOAD_DIR=/home/<cpanel-user>/api-uploads

# --- Misc ---
# NODE_ENV=production
# DB_POOL_MAX=5
# PORT is assigned by cPanel/Passenger automatically; leave unset.
