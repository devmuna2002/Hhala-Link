# ================================================================
#  HLALA LINK — STANDALONE DATABASE ENVIRONMENT CONFIG (.env.example)
# ================================================================

POSTGRES_USER=hlala_link
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=hlala_link
POSTGRES_PORT=5432

JWT_SECRET=replace-with-at-least-32-random-bytes
ANON_KEY=replace-with-a-generated-anon-jwt
SERVICE_ROLE_KEY=replace-with-a-generated-service-role-jwt

GATEWAY_PORT=8000
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000

STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
