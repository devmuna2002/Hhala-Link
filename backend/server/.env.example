# ============================================================
# Hlala Link API (MySQL) — cPanel environment variables
# Enter these in Setup Node.js App > Environment Variables.
# NEVER commit real values to git.
# ============================================================

# --- Database: cPanel MySQL (use the full prefixed names) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hlala_hlala_link
MYSQL_USER=hlala_hlala_link
MYSQL_PASSWORD=replace-with-the-mysql-user-password
# MYSQL_SSL=true  # only if the host requires TLS for local MySQL

# --- Auth (generate a fresh one per environment) ---
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=replace-with-at-least-32-random-bytes

# --- CORS: exact frontend origin(s), comma-separated, no trailing slash ---
CORS_ORIGINS=https://raisdaglobal.co.zw,https://www.raisdaglobal.co.zw

# --- Uploads: keep outside the public web root ---
# UPLOAD_DIR=/home/hlala/api-uploads

# --- Misc ---
# NODE_ENV=production  (set automatically by the Node.js app mode)
# DB_POOL_MAX=5
# PORT is assigned by cPanel/Passenger automatically; leave unset.

# --- One-off data migration (run from your own computer, not cPanel) ---
# SOURCE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# MYSQL_URL=mysql://[cpanel-mysql-user]:[password]@[your-public-ip-or-host]:3306/[database]
